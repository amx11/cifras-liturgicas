rules_version = '2';
// Regras do Firestore do app Cifras Litúrgicas (Console do Firebase → Firestore Database → Regras → Publicar).
// - CONTA: cada pessoa só lê/escreve o que é seu (/usuarios/{uid}/...): missas, cifras, nomes editados, preferências
// - MINISTÉRIO (opcional): só membros leem; só o COORDENADOR muda e CADASTRA pessoas pelo e-mail (/cadastros/{email});
//   a pessoa só entra no ministério se o próprio e-mail (da conta Google) estiver cadastrado, com o papel do cadastro
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function meuEmail() { return request.auth.token.email.lower(); }
    function caminhoMembro(g) { return /databases/$(database)/documents/grupos/$(g)/membros/$(request.auth.uid); }
    function membro(g) { return logado() && exists(caminhoMembro(g)); }
    function coordenador(g) { return membro(g) && get(caminhoMembro(g)).data.papel == 'coordenador'; }

    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
      match /{doc=**} {
        allow read, write: if logado() && request.auth.uid == uid;
      }
    }

    // cadastro de uma pessoa num ministério, pelo e-mail (o coordenador cria; a própria pessoa lê o seu)
    match /cadastros/{email} {
      allow get: if logado() && (meuEmail() == email || coordenador(resource.data.grupo));
      allow list: if logado() && coordenador(resource.data.grupo);
      allow create, update: if logado() && coordenador(request.resource.data.grupo);
      allow delete: if logado() && (coordenador(resource.data.grupo) || meuEmail() == email);
    }

    match /grupos/{g} {
      allow read: if membro(g);
      allow create: if logado() && request.resource.data.criadoPor == request.auth.uid;
      allow update, delete: if coordenador(g);

      match /membros/{uid} {
        allow read: if membro(g);
        // entrar: quem criou o ministério, como coordenador; os outros só com o e-mail cadastrado, com o papel do cadastro
        allow create: if logado() && request.auth.uid == uid && (
          (request.resource.data.papel == 'coordenador'
            && get(/databases/$(database)/documents/grupos/$(g)).data.criadoPor == request.auth.uid)
          || (exists(/databases/$(database)/documents/cadastros/$(meuEmail()))
            && get(/databases/$(database)/documents/cadastros/$(meuEmail())).data.grupo == g
            && get(/databases/$(database)/documents/cadastros/$(meuEmail())).data.papel == request.resource.data.papel));
        allow update: if coordenador(g);
        allow delete: if coordenador(g) || (logado() && request.auth.uid == uid);
      }
      match /missas/{id} {
        allow read: if membro(g);
        allow write: if coordenador(g);
      }
      match /musicas/{id} {
        allow read: if membro(g);
        allow write: if coordenador(g);
      }
    }
  }
}
