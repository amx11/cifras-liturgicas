{
  "name": "Cifras Litúrgicas",
  "short_name": "Cifras",
  "description": "Cifras de música litúrgica: busca por tempo litúrgico, transposição e montagem de missas.",
  "lang": "pt-BR",
  "start_url": "./#/musicas",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f4ef",
  "theme_color": "#2f5d50",
  "icons": [
    {
      "src": "icone-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icone-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icone.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./compartilhar-folheto",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "folheto",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  }
}
